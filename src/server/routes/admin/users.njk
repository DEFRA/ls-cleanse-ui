{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  <p class="govuk-body"><a class="govuk-back-link" href="/admin">Back to admin</a></p>
  {% if notification %}
    {{ govukNotificationBanner({ type: "success", titleText: "Success", text: notification }) }}
  {% endif %}
  <h1 class="govuk-heading-l">Users</h1>
  {% if error %}
    <p class="govuk-body">{{ error }}</p>
  {% else %}
    <p class="govuk-body">Everyone issues can be assigned to: people who have signed in, and people added here or by a SPOL import before they first sign in. This is not a list of who may sign in, which is managed in Entra. All times are UTC.</p>
    {{ govukButton({ text: "Add users", href: "/admin/users/add", classes: "govuk-button--secondary" }) }}
    {% if users | length %}
      <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m">{{ total }} user{{ "s" if total != 1 }}</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Full name</th>
            <th scope="col" class="govuk-table__header">Email</th>
            <th scope="col" class="govuk-table__header">Last logon (UTC)</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for user in users %}
            <tr class="govuk-table__row">
              <th scope="row" class="govuk-table__header">
                {{ user.fullName }}
                <span class="govuk-body-s app-user-id">ID: {{ user.id }}</span>
              </th>
              <td class="govuk-table__cell">{{ user.email or "Not recorded" }}</td>
              <td class="govuk-table__cell">
                {% if user.lastLogon %}
                  <time datetime="{{ user.lastLoggedInAtUtc }}">{{ user.lastLogon }}</time>
                {% else %}
                  Never
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="govuk-body">Nobody has been added or signed in yet.</p>
    {% endif %}
    <nav aria-label="Pagination">
      {% if previous %}<a class="govuk-link govuk-!-margin-right-4" href="{{ previous }}">Previous page</a>{% endif %}
      {% if next %}<a class="govuk-link" href="{{ next }}">Next page</a>{% endif %}
    </nav>
  {% endif %}
{% endblock %}
