{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to the dataset", href: "/admin/datasets/" + dataset.id }) }}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [{ text: error, href: "#delete" }]
      }) }}
    {% endif %}

    <span class="govuk-caption-l">{{ dataset.name }}</span>
    <h1 class="govuk-heading-l">Delete this dataset?</h1>

    {{ govukWarningText({
      text: "This deletes the dataset and its " + dataset.rows + " rows. There is no undo.",
      iconFallbackText: "Warning"
    }) }}

    <p class="govuk-body">
      Its processing runs, and their reports, are kept. Nothing the dataset has changed on issues
      and holdings is undone.
    </p>

    <form method="post" action="/admin/datasets/{{ dataset.id }}/delete" novalidate>
      <input type="hidden" name="crumb" value="{{ crumb }}">

      {{ govukButton({
        text: "Delete dataset",
        classes: "govuk-button--warning",
        attributes: { id: "delete" }
      }) }}

      <p class="govuk-body">
        <a class="govuk-link govuk-link--no-visited-state" href="/admin/datasets/{{ dataset.id }}">Cancel</a>
      </p>
    </form>

  </div>
</div>

{% endblock %}
