{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block backLink %}
  {{ govukBackLink({ text: "Back to SPOL datasets", href: "/admin/datasets" }) }}
{% endblock %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">{{ groupId }}</span>
    <h1 class="govuk-heading-l">SPOL imports</h1>

    <p class="govuk-body">
      Every time a SPOL dataset has been processed, and the file uploads that came before
      datasets. To bring SPOL's triage state onto the issues, process a dataset from
      <a class="govuk-link govuk-link--no-visited-state" href="/admin/datasets">SPOL datasets</a>.
    </p>

  </div>
</div>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">

    <h2 class="govuk-heading-m">Recent imports</h2>

    {% if imports | length %}
      <table class="govuk-table app-table--compact">
        <caption class="govuk-visually-hidden">Recent SPOL imports, newest first</caption>
        <thead class="govuk-table__head">
          <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Dataset or file</th>
            <th scope="col" class="govuk-table__header">Started</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Rows</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Matched</th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">Unmatched</th>
          </tr>
        </thead>
        <tbody class="govuk-table__body">
          {% for job in imports %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell">
                <a class="govuk-link govuk-link--no-visited-state" href="/admin/imports/{{ job.id }}">{{ job.fileName }}</a>
              </td>
              <td class="govuk-table__cell">{{ job.createdAtUtc | govukDateTime }}</td>
              <td class="govuk-table__cell">
                {{ govukTag({
                  text: job.statusDetail.name,
                  classes: "govuk-tag--" + job.statusDetail.colour
                }) }}
                {% if job.status == "processing" %}
                  <span class="app-secondary-text">{{ job.percentComplete }}%</span>
                {% endif %}
              </td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ job.totalRows }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ job.matched }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric">{{ job.unmatched }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="govuk-body">Nothing has been imported yet.</p>
    {% endif %}

  </div>
</div>

{% endblock %}
