{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <span class="govuk-caption-l">CPH {{ issue.cph }}</span>
    <h1 class="govuk-heading-l">You cannot do that</h1>

    <p class="govuk-body">
      This issue is <b>{{ issue.workflowDetail.name }}</b>, and it cannot move straight to
      <b>{{ attempted }}</b> from there.
    </p>

    <p class="govuk-body">
      Move it back to <b>To do</b> first, then try again.
    </p>

    {{ govukButton({ text: "Back to the issue", href: "/issues/" + issue.id }) }}

  </div>
</div>

{% endblock %}
