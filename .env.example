AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# CDP uses federated; locally there is no STS, so use a test-tenant client secret.
ENTRA_CLIENT_AUTH=secret
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
# The startup scripts generate and persist these in .env when missing.
SESSION_COOKIE_PASSWORD=
ADMIN_PASSWORD=
PASSWORD=
